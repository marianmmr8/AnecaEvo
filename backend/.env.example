# Plantilla de configuración (esta sí puede subirse a Git porque NO lleva claves reales)
PORT=4000

# Conexión a la base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aneca evo

# Clave secreta para firmar tokens JWT (cámbiala en producción)
JWT_SECRET=pon_aqui_tu_clave_secreta

# Opcional: clave secreta de Stripe para cobros reales
STRIPE_SECRET_KEY=
